<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Master.cs" Inherits="pra_10_introduction_to_master_page.Site1" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <title></title>
    
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <div class="header">
            <h1>My Website</h1>
        </div>



        <div class="menu">
            <asp:HyperLink 
                ID="HyperLink1" 
                runat="server"
                NavigateUrl="~/Home.aspx">Home</asp:HyperLink>

            <asp:HyperLink 
                ID="HyperLink2" 
                runat="server"
                NavigateUrl="~/About.aspx">About</asp:HyperLink>

            <asp:HyperLink 
                ID="HyperLink3" 
                runat="server"
                NavigateUrl="~/Contact.aspx">Contact</asp:HyperLink>
        </div>



        <div class="content">
            <asp:ContentPlaceHolder 
                ID="ContentPlaceHolder1" 
                runat="server">
            </asp:ContentPlaceHolder>
        </div>
        
    </form>
</body>
</html>
